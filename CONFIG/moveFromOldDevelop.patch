-                                    sizeof(E2nodeComponentInterfaceF1_t));
-                                }
-                                DU_FREE(e2NodeAddList->list.array[e2NodeAddListIdx], sizeof(E2nodeComponentConfigAddition_ItemIEs_t));
-                             }
