-      
-      /* RIC Request ID */
-      ieIdx = 0;
-      ricSubsDelReqIe = ricSubsDelReq->protocolIEs.list.array[ieIdx];
-      ricSubsDelReqIe->id = ProtocolIE_IDE2_id_RICrequestID;
-      ricSubsDelReqIe->criticality = CriticalityE2_reject;
