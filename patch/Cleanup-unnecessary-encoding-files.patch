- * Encode INTEGER type using DER.
- */
-asn_enc_rval_t
-INTEGER_encode_der(const asn_TYPE_descriptor_t *td, const void *sptr,
-                   int tag_mode, ber_tlv_tag_t tag, asn_app_consume_bytes_f *cb,
-                   void *app_key) {
