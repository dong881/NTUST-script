-        ST_LEADSPACE,
-        ST_WAITDIGITS,
-        ST_DIGITS,
-        ST_ZERO,
-        ST_DIGITS_TRAILSPACE,
-        ST_UNEXPECTED
-    } state = ST_LEADSPACE;
