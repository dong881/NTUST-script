-		*ch_type = PJER_TEXT;
-		break;
-	case PJSON_KEY:
-		*ch_type = PJER_WMORE;
-        break;
-    case PJSON_DLM:
-        *ch_type = PJER_DLM;
-        break;
-	case PJSON_KEY_END:
-		*ch_type = PJER_KEY;
-        break;
-	case PJSON_VALUE_END:
-		*ch_type = PJER_VALUE;
