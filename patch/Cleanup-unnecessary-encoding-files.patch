-    const void *ptr, size_t size,
-    int tag_mode,      /* {-1,0,1}: IMPLICIT, no, EXPLICIT */
-    int last_tag_form, /* {-1,0:1}: any, primitive, constr */
-    ber_tlv_len_t *last_length, int *opt_tlv_form /* optional tag form */
-);
-
-#ifdef __cplusplus
-}
-#endif
-
-#endif	/* _BER_DECODER_H_ */
