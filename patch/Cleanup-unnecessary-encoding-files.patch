-        NEXT_PHASE(ctx);
-    case 2:
-        /*
-         * Read in all "end of content" TLVs.
-         */
-        while(ctx->left < 0) {
-            if(LEFT < 2) {
-                if(LEFT > 0 && ((const char *)ptr)[0] != 0) {
-                    /* Unexpected tag */
-                    RETURN(RC_FAIL);
-                } else {
-                    RETURN(RC_WMORE);
-                }
-            }
-            if(((const char *)ptr)[0] == 0
-            && ((const char *)ptr)[1] == 0) {
-                ADVANCE(2);
-                ctx->left++;
-            } else {
-                RETURN(RC_FAIL);
-            }
-        }
-
-        PHASE_OUT(ctx);
-    }
-
-    RETURN(RC_OK);
