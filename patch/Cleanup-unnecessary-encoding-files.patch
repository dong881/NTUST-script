-            case RCBRAC: /* Empty object { } */
-                TOKEN_CB_FINAL(PJSON_VALUE, ST_TEXT, 1);
-                break;
-            case CQUOTE: /* Key start */
-                TOKEN_CB(PJSON_TEXT, ST_KEY_BODY, 0);
-                break;
-            default:
-                break;
-            }
-            break;
-
-        case ST_KEY_BODY: /* Inside key */
-            switch(C) {
-            case CQUOTE: /* Key end */
-                TOKEN_CB_FINAL(PJSON_KEY, ST_COLON, 1);
-                break;
-            default:
-                break;
-            }
-            break;
